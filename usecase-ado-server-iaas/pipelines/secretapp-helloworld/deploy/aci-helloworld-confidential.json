{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Confidential ACI deployment for the SecretApp Secure Key Release (SKR) demo. Only an image whose confidential-computing enforcement (CCE) policy SHA-256 matches the AKV key release policy is able to obtain the wrap key and unseal the app secret. The wrap key never leaves the vault except to an attested, policy-matching enclave. Registry pulls use a user-assigned managed identity (AcrPull) — no admin credentials are embedded."
  },
  "parameters": {
    "containerGroupName": {
      "type": "string",
      "metadata": { "description": "Name of the confidential container group." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region that supports Confidential ACI (e.g. northeurope)." }
    },
    "appImage": {
      "type": "string",
      "metadata": { "description": "Fully-qualified, digest-pinned image reference, e.g. myacr.azurecr.io/secretapp@sha256:..." }
    },
    "registryServer": {
      "type": "string",
      "metadata": { "description": "ACR login server, e.g. myacr.azurecr.io." }
    },
    "managedIdentityId": {
      "type": "string",
      "metadata": { "description": "Resource ID of the user-assigned managed identity. Needs AcrPull on the registry and get+release on the AKV key." }
    },
    "maaEndpoint": {
      "type": "string",
      "metadata": { "description": "Microsoft Azure Attestation endpoint host, e.g. sharedneu.neu.attest.azure.net." }
    },
    "akvEndpoint": {
      "type": "string",
      "metadata": { "description": "Azure Key Vault endpoint host, e.g. mykeyvault.vault.azure.net." }
    },
    "skrKeyName": {
      "type": "string",
      "metadata": { "description": "Name of the exportable HSM wrap key in Key Vault." }
    },
    "ccePolicyBase64": {
      "type": "string",
      "metadata": { "description": "Base64-encoded confidential-computing enforcement (CCE) Rego policy produced by az confcom acipolicygen." }
    },
    "dnsNameLabel": {
      "type": "string",
      "metadata": { "description": "DNS name label for the public IP." }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerGroupName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[parameters('managedIdentityId')]": {}
        }
      },
      "properties": {
        "sku": "Confidential",
        "confidentialComputeProperties": {
          "ccePolicy": "[parameters('ccePolicyBase64')]"
        },
        "osType": "Linux",
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "secretapp",
            "properties": {
              "image": "[parameters('appImage')]",
              "command": [ "python", "/app/entrypoint.py" ],
              "ports": [
                { "protocol": "TCP", "port": 8080 }
              ],
              "environmentVariables": [
                { "name": "MAA_ENDPOINT", "value": "[parameters('maaEndpoint')]" },
                { "name": "AKV_ENDPOINT", "value": "[parameters('akvEndpoint')]" },
                { "name": "SKR_KEY_NAME", "value": "[parameters('skrKeyName')]" }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 2
                }
              },
              "volumeMounts": [
                {
                  "name": "sealed",
                  "mountPath": "/run/sealed"
                }
              ]
            }
          }
        ],
        "volumes": [
          {
            "name": "sealed",
            "emptyDir": {}
          }
        ],
        "imageRegistryCredentials": [
          {
            "server": "[parameters('registryServer')]",
            "identity": "[parameters('managedIdentityId')]"
          }
        ],
        "ipAddress": {
          "type": "Public",
          "dnsNameLabel": "[parameters('dnsNameLabel')]",
          "ports": [
            {
              "protocol": "TCP",
              "port": 8080
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName'))).ipAddress.fqdn]"
    },
    "url": {
      "type": "string",
      "value": "[format('http://{0}:8080/', reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName'))).ipAddress.fqdn)]"
    }
  }
}
